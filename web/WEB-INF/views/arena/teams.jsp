<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>

<html class="light" lang="es"><head><meta charset="utf-8"/><meta content="width=device-width, initial-scale=1.0" name="viewport"/><meta content="web_standard" name="shell-type"/><link href="https://fonts.googleapis.com" rel="preconnect"/><link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Space+Grotesk:wght@600;700&amp;display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"/><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><link href="<%=request.getContextPath()%>/css/stitch.css" rel="stylesheet"/><link href="<%=request.getContextPath()%>/css/stitch-bridge.css" rel="stylesheet"/></head><body class="bg-background font-body-md text-body-md text-on-surface antialiased arena-loading" data-arena-page="teams"><div aria-busy="true" aria-label="Cargando datos del torneo" id="arena-skeleton">
<div class="ske-nav"><div class="ske-block" style="width:160px;height:28px"></div><div class="ske-block" style="width:300px;height:16px"></div><div class="ske-block" style="width:120px;height:25px"></div></div>
<div class="ske-hero"><div><div class="ske-block" style="width:110px;height:14px"></div><div class="ske-block" style="width:80%;height:52px"></div><div class="ske-block" style="width:66%;height:18px"></div><div class="ske-block" style="width:73%;height:18px"></div><div class="ske-block" style="width:45%;height:35px"></div></div><div class="ske-block ske-cover"></div></div>
<div class="ske-cards"><div class="ske-block"></div><div class="ske-block"></div><div class="ske-block"></div><div class="ske-block"></div></div>
<div class="ske-panel"><div class="ske-block" style="width:35%;height:25px"></div><div class="ske-block" style="height:120px"></div><div class="ske-block" style="height:24px;width:70%"></div></div>
<div class="ske-panel"><div class="ske-block" style="width:42%;height:25px"></div><div class="ske-cards"><div class="ske-block"></div><div class="ske-block"></div></div></div>
</div><noscript><p style="padding:2rem;background:#fef3c7;color:#111">La interfaz necesita JavaScript para consultar los datos del torneo. Activá JavaScript para continuar.</p></noscript><%@ include file="partials/header.jspf" %><main class="w-full pt-28 bg-background min-h-screen" data-arena-main=""><% if (request.getAttribute("flash") != null) { %><div class="arena-flash <%= "error".equals(request.getAttribute("flashKind")) ? "error" : "" %>" role="status"><%=com.torneo.Web.esc(String.valueOf(request.getAttribute("flash")))%></div><% } %><section class="w-full bg-primary text-on-primary px-margin py-space-xl"><div class="mx-auto max-w-6xl"><span class="text-secondary font-label-md text-label-md uppercase tracking-widest">BRACKET ARENA · TEMPORADA 2026</span><h1 class="font-headline-xl text-headline-xl uppercase mt-2">EQUIPOS E INSCRIPCIONES</h1><p class="font-body-lg text-body-lg text-primary-fixed mt-3">Consulta los clubes registrados y postulá tu equipo para el próximo torneo.</p></div></section>
<section class="w-full px-margin py-space-xl"><div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg max-w-7xl mx-auto">
<div class="lg:col-span-7 bg-surface shadow-md rounded-xl p-space-lg"><div class="flex items-center justify-between mb-space-md"><div><span class="font-label-sm text-label-sm text-secondary tracking-widest">REGISTRO NACIONAL</span><h2 class="font-headline-lg text-headline-lg">DIRECTORIO DE EQUIPOS</h2></div><span class="material-symbols-outlined text-secondary">groups</span></div><div class="grid grid-cols-1 md:grid-cols-2 gap-space-md" id="arena-teams-list"></div></div>
<div class="lg:col-span-5 bg-surface shadow-md rounded-xl p-space-lg"><div class="flex items-center justify-between mb-space-md"><div><span class="font-label-sm text-label-sm text-secondary tracking-widest">SOLICITUD DE INGRESO</span><h2 class="font-headline-lg text-headline-lg">INSCRIBIR UN EQUIPO</h2></div><span class="material-symbols-outlined text-secondary">app_registration</span></div>
<form class="arena-stitch-form" id="arena-team-form" method="post"><input name="csrf" value="<%=com.torneo.Web.esc((String)request.getAttribute("csrf"))%>" type="hidden"/><input name="action" type="hidden" value="team.create"/><label>Nombre del equipo<input maxlength="100" minlength="3" name="name" placeholder="Nombre oficial del club" required=""/></label><label>Teléfono de contacto<input maxlength="20" name="phone" placeholder="8888-8888" required=""/></label><label>URL del escudo (opcional)<input maxlength="1024" name="shield" placeholder="https://..." type="url"/></label><p class="text-on-surface-variant font-body-sm text-body-sm">Cada inscripción requiere la aprobación del administrador.</p><button class="arena-action" type="submit">SOLICITAR INSCRIPCIÓN</button></form>
</div></div></section></main><footer class="w-full bg-surface-container-low py-space-xl mt-space-xl"><div class="w-full px-margin flex flex-col md:flex-row items-center justify-between gap-space-md"><div class="flex items-center gap-space-sm"><div class="w-6 h-6 rounded bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-secondary text-[14px]">emoji_events</span></div><span class="font-headline-md text-headline-md uppercase text-on-surface">BRACKET ARENA</span></div><div class="font-body-sm text-body-sm text-on-surface-variant text-center">© 2026 Bracket Arena Technologies. Sistema Profesional de Gestión de Torneos Eliminatorios.</div><div class="flex items-center gap-space-md font-label-sm text-label-sm text-on-surface-variant uppercase"><a class="hover:text-on-surface transition-colors" href="#">Reglamento</a><a class="hover:text-on-surface transition-colors" href="#">Soporte</a><a class="hover:text-on-surface transition-colors" href="#">API Torneo</a></div></div></footer><script>window.ARENA_BASE = '<%=request.getContextPath()%>';</script><script defer="" src="<%=request.getContextPath()%>/js/stitch-runtime.js"></script></body></html>