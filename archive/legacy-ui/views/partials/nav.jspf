<%@page import="com.torneo.Store,com.torneo.Web,com.torneo.MatchSimulation,java.util.*,java.time.*,java.math.*"%>
<%
    Store.User signedIn = Web.user(request);
    String ctx = request.getContextPath();
    String token = (String) request.getAttribute("csrf");
    String viewName = (String) request.getAttribute("view");
    String flashText = (String) request.getAttribute("flash");
    String flashKind = (String) request.getAttribute("flashKind");
%>
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#07141a">
  <title>Bracket Arena | Torneos eliminatorios</title>
  <meta name="description" content="Gestiona torneos de eliminación directa: 16 equipos, llaves, resultados en vivo y campeón.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="<%=ctx%>/css/arena.css">
</head>
<body>
<div class="background-glow" aria-hidden="true"></div>
<a class="skip-link" href="#main">Ir al contenido</a>
<nav class="site-nav" aria-label="Navegación principal">
  <div class="nav-content">
    <a class="brand" href="<%=ctx%>/app?view=inicio" aria-label="Bracket Arena inicio">
      <span class="brand-symbol">✦</span><span>BRACKET<span class="brand-accent">ARENA</span></span>
    </a>
    <button class="mobile-menu-button" type="button" aria-label="Abrir navegación" aria-expanded="false" data-menu-toggle>☰</button>
    <div class="nav-links" data-menu>
      <a class="<%="inicio".equals(viewName) ? "current" : ""%>" href="<%=ctx%>/app?view=inicio">Inicio</a>
      <a class="<%="equipos".equals(viewName) ? "current" : ""%>" href="<%=ctx%>/app?view=equipos">Equipos</a>
      <% if (signedIn != null && signedIn.admin()) { %>
      <a class="<%="admin".equals(viewName) ? "current" : ""%>" href="<%=ctx%>/app?view=admin">Administración</a>
      <% } %>
      <% if (signedIn == null) { %>
        <a href="<%=ctx%>/app?view=login" class="nav-login">Ingresar</a>
        <a href="<%=ctx%>/app?view=registro" class="btn-neon btn-small">Crear cuenta <span>↗</span></a>
      <% } else { %>
        <span class="user-chip"><span class="user-dot"></span><%=Web.esc(signedIn.name)%> <small><%=signedIn.admin() ? "ADMIN" : "USUARIO"%></small></span>
        <form action="<%=ctx%>/app" method="post" class="logout-form">
          <input type="hidden" name="csrf" value="<%=Web.esc(token)%>">
          <input type="hidden" name="action" value="logout">
          <button class="nav-login" type="submit">Salir ↗</button>
        </form>
      <% } %>
    </div>
  </div>
</nav>
<main id="main" class="app-main">
<% if (flashText != null) { %>
<div class="flash-message <%= "error".equals(flashKind) ? "flash-error" : "flash-ok" %>" role="status" data-flash>
  <span><%= "error".equals(flashKind) ? "⚠" : "✓" %></span>
  <p><%=Web.esc(flashText)%></p>
  <button type="button" aria-label="Cerrar notificación" data-dismiss-flash>×</button>
</div>
<% } %>
<% if (request.getAttribute("dbError") != null) { %>
<div class="flash-message flash-error" role="alert"><span>⚠</span><p><%=Web.esc((String)request.getAttribute("dbError"))%></p></div>
<% } %>
